# Copie para backend/.env (o .env real NUNCA vai para o Git).

# Ambiente: development | production | test
APP_ENV=development

# Origens permitidas no CORS, separadas por vírgula.
# Em development, http://localhost:5173 a 5199 já é aceito automaticamente.
CORS_ORIGINS=http://localhost:5173

# Nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Banco de dados (PostgreSQL via asyncpg). Formato:
#   postgresql+asyncpg://USUARIO:SENHA@HOST:PORTA/BANCO
#
# 1) API rodando LOCALMENTE com uv (o banco do compose publica a porta no seu PC):
DATABASE_URL=postgresql+asyncpg://vocalize:vocalize_dev@localhost:5432/vocalize
#
# 2) API rodando NO DOCKER: o host é "db" (nome do serviço no docker-compose.yml).
#    O compose já força esse valor para o serviço api, então não precisa mudar este arquivo:
#    DATABASE_URL=postgresql+asyncpg://vocalize:vocalize_dev@db:5432/vocalize

# Tamanho do pool de conexões (opcional).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
